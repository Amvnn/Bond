*.sqlite3
*.db
*.sql.gz
pgdata/
redisdata/

# ---------------------------------------------------------------------------
# Editor / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Local scratch space — prototypes, throwaway experiments, design explorations
# ---------------------------------------------------------------------------
Demo-testing/

# ---------------------------------------------------------------------------
# A literal "~" directory: a shell path that did not expand, so a clone landed
# inside the repository instead of in the home directory. Not part of Bond,
# and it carries its own .git. Ignored rather than deleted - it is somebody's
# data, just in the wrong place.
# ---------------------------------------------------------------------------
client/~/
