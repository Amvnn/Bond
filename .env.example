# Copy to .env and fill in. .env is gitignored and must never be committed.
# Every value below is a placeholder. Generate real secrets with a CSPRNG, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- PostgreSQL ---------------------------------------------------------------
# Must not be reachable from the public internet in production.
DATABASE_URL=postgresql://messenger:CHANGE_ME@localhost:5433/privatemessenger
DATABASE_SSL=false

# --- Redis -------------------------------------------------------------------
# Must not be reachable from the public internet in production.
REDIS_URL=redis://localhost:6379

# --- Token signing -----------------------------------------------------------
# Distinct secrets. Never reuse one for both. Rotate independently.
ACCESS_TOKEN_SECRET=CHANGE_ME_generate_48_random_bytes
REFRESH_TOKEN_SECRET=CHANGE_ME_generate_48_random_bytes_different
INVITATION_TOKEN_PEPPER=CHANGE_ME_generate_48_random_bytes_third
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# --- Transport ---------------------------------------------------------------
# TLS terminates at the reverse proxy. Never disable certificate verification.
PUBLIC_ORIGIN=https://localhost
CORS_ALLOWED_ORIGINS=
MAX_REQUEST_BODY_BYTES=65536
ENABLE_HSTS=false
# Enable ONLY when behind the reverse proxy; otherwise clients can spoof their IP.
TRUST_PROXY=false

# --- Rate limits (requests per window) ---------------------------------------
RATE_LIMIT_AUTH_PER_15M=10
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_INVITE_CREATE_PER_DAY=20
RATE_LIMIT_INVITE_ACCEPT_PER_HOUR=10
RATE_LIMIT_PREKEY_FETCH_PER_HOUR=120
RATE_LIMIT_MESSAGE_SEND_PER_MINUTE=120
RATE_LIMIT_WS_CONNECT_PER_MINUTE=10

# --- Retention (see docs/security-model.md) ----------------------------------
QUEUED_MESSAGE_TTL_DAYS=30
SECURITY_EVENT_TTL_DAYS=90
INVITATION_TTL_HOURS=72

# --- Bootstrap ---------------------------------------------------------------
# Privileged one-time path that creates user #1, who cannot be invited by anyone.
# MUST be false in normal operation. See docs/decisions.md D3.
ALLOW_BOOTSTRAP_ACCOUNT=false
